#!/command/with-contenv sh
# svc-omnigent-server — the upstream Python service. All env comes from
# init-addon-config's materialised container_environment dir.
#
# pip installs the `omnigent` entry point under /usr/bin on Alpine (via
# --break-system-packages), but PATH inside the s6-oneshot env isn't
# guaranteed. Set it explicitly and fall back to an absolute path if the
# binary lives somewhere unusual.
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if command -v omnigent >/dev/null 2>&1; then
    exec omnigent server
elif [ -x /usr/bin/omnigent ]; then
    exec /usr/bin/omnigent server
else
    echo "[svc-omnigent-server] FATAL: omnigent binary not found in PATH=$PATH" >&2
    exit 1
fi
